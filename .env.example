# Copy this file to .env and add your key.
# Get a Gemini API key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: two keys as two quota pools. If both are set, batch runs use the
# first and the live mic path uses the second. Each falls back to the other
# on a rate limit.
# Workshop_API_key=
# Default_gemini_API_Key=

# Only for a public server (see Dockerfile). Leave these out on a laptop.
# HOSTED=1
# ACCESS_CODE=
# LIVE_DAILY_LIMIT=40
# RETAIN_MINUTES=30
