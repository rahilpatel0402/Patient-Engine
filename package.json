{
  "name": "patient-engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "An exam for clinical AI's senses. Station 1: Listening.",
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm:server\" \"npm:client\"",
    "server": "tsx watch server/index.ts",
    "client": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "smoke": "tsx smoke/run.ts",
    "export:static": "tsx scripts/export-static.ts",
    "build:static": "vite build --mode static",
    "showcase": "tsx scripts/export-static.ts && vite build --mode static && node -e \"const fs=require('fs');fs.rmSync('docs',{recursive:true,force:true});fs.cpSync('dist/static','docs',{recursive:true})\""
  },
  "dependencies": {
    "@google/genai": "^3.6.1",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "ffmpeg-static": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
